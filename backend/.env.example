# Copy to .env and fill in what you have. Everything is optional —
# without keys the app uses local heuristics and Vosk.

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Or a local Ollama server: https://ollama.com  (zero-cost, fully offline)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Overrides
# FFMPEG_BIN=/usr/bin/ffmpeg
# VOSK_MODEL_PATH=/path/to/vosk-model-small-en-us-0.15
# SILENCE_NOISE_DB=-35
# SILENCE_MIN_DUR=0.35

# ── Asset packs (meme clips + VFX sounds) ────────────────────────────────────
# Optional keys for scripts/fetch_packs.py. Nothing here is needed at runtime:
# the committed offline kit (assets/sfx/vfx) already covers boom/whoosh/riser/…
# and /api/packs/build can regenerate it.
#   Pixabay: free key shown at https://pixabay.com/api/docs/ (their API covers
#   images/videos; the sound pack is scraped from the public search pages).
PIXABAY_API_KEY=
#   Vlipsy: request a developer key from api@vlipsy.com (used for /v1/vlips/search)
VLIPSY_API_KEY=
# Override where packs live (e.g. a mounted volume):
# SFX_PACK_DIR=/var/data/sfx/vfx
# MEMES_DIR=/var/data/memes
